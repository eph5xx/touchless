{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touchless",
  "identifier": "com.touchless.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Touchless",
        "width": 720,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Touchless Overlay",
        "width": 520,
        "height": 132,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMjY4NTNENEJFRjBCNEEKUldSS0MrOUxQWVVtVTNBcTdYY0dRdWFKb0FrOHBMRVVwUmY3bmI2aXNaWXBGUWtjdmVvWFNxb0sK",
      "endpoints": [
        "https://github.com/eph5xx/touchless/releases/latest/download/latest.json"
      ]
    }
  }
}
